{
  "name": "simple-chat-monorepo",
  "version": "1.0.0",
  "description": "WebRTC-based chat application with CoTURN and signaling server",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/meteor-app dev",
    "start": "bun run start:all",
    "start:all": "bunx concurrently \"bun run --cwd apps/meteor-app start\" \"bun run --cwd services/signaling-server start\"",
    "start:meteor": "bun run --cwd apps/meteor-app start",
    "start:signaling": "bun run --cwd services/signaling-server start",
    "dev:signaling": "bun run --cwd services/signaling-server dev",
    "build:signaling": "bun run --cwd services/signaling-server build",
    "build": "bun run build:signaling",
    "test": "bun run --cwd apps/meteor-app test",
    "test:app": "bun run --cwd apps/meteor-app test:app",
    "postinstall": "sh scripts/setup-symlinks.sh"
  }
}
