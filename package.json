{
  "name": "simple-chat-monorepo",
  "private": true,
  "workspaces": [
    "servers/*"
  ],
  "scripts": {
    "dev": "meteor run",
    "start": "bunx concurrently \"meteor run\" \"bun run start:signaling\"",
    "start:signaling": "bun run servers/signaling-server/index.ts",
    "dev:signaling": "bun run --cwd servers/signaling-server dev",
    "build:signaling": "bun run --cwd servers/signaling-server build",
    "test": "meteor test --once --driver-package meteortesting:mocha",
    "test:app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "dsv": "bash deploy.sh",
    "postinstall": "flowbite-react register"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@hookform/resolvers": "^5.2.2",
    "@jitsi/react-sdk": "^1.4.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.18",
    "flowbite-react": "^0.12.17",
    "meteor-node-stubs": "^1.2.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/mocha": "^8.2.3",
    "@types/node": "^22.19.10",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.tsx",
      "server": "server/main.ts"
    },
    "testModule": "tests/main.ts"
  }
}
